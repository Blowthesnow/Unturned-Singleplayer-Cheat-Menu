<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UnturnedSingleplayerCheatMenu</AssemblyName>
    <RootNamespace>UnturnedSingleplayerCheatMenu</RootNamespace>
    <Version>1.7.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</OutputPath>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CheatMenuPlugin.cs" />
    <Compile Include="Models\FavoriteAssetCollection.cs" />
    <Compile Include="Models\ItemFilterSnapshot.cs" />
    <Compile Include="Models\ItemFilterState.cs" />
    <Compile Include="Models\TeleportPoint.cs" />
    <Compile Include="Models\PointToolAction.cs" />
    <Compile Include="Models\PointToolDecisionInput.cs" />
    <Compile Include="Models\PointToolMode.cs" />
    <Compile Include="Models\PointToolRaycastSnapshot.cs" />
    <Compile Include="Patches\GodModePatch.cs" />
    <Compile Include="Patches\MovementSimulationPatch.cs" />
    <Compile Include="Patches\PointToolInteractionPatch.cs" />
    <Compile Include="Services\AssetCatalog.cs" />
    <Compile Include="Services\CheatActions.cs" />
    <Compile Include="Services\FavoriteStore.cs" />
    <Compile Include="Services\IconCache.cs" />
    <Compile Include="Services\ItemFilterService.cs" />
    <Compile Include="Services\MovementCheatService.cs" />
    <Compile Include="Services\MovementSpeedProfile.cs" />
    <Compile Include="Services\NativeShortcutDetector.cs" />
    <Compile Include="Services\PluginLocalization.cs" />
    <Compile Include="Services\PluginRuntimeHost.cs" />
    <Compile Include="Services\PointToolActionGate.cs" />
    <Compile Include="Services\PointToolService.cs" />
    <Compile Include="Services\ShortcutToggleGate.cs" />
    <Compile Include="Services\SingleplayerGuard.cs" />
    <Compile Include="Services\TeleportMapService.cs" />
    <Compile Include="Services\TeleportStore.cs" />
    <Compile Include="Services\VehicleIconDiskCache.cs" />
    <Compile Include="Services\VehicleIconRenderer.cs" />
    <Compile Include="Services\VehicleThumbnailRenderSettings.cs" />
    <Compile Include="UI\CheatMenuOverlayUi.cs" />
    <Compile Include="UI\CheatMenuOverlayUi.PointMovement.cs" />
    <Compile Include="UI\CheatMenuStyle.cs" />
    <Compile Include="UI\CheatMenuUi.cs" />
    <Compile Include="UI\PointToolHud.cs" />
    <Compile Include="UI\TeleportMapSurface.cs" />
    <Compile Include="UI\TeleportMarkerIconFactory.cs" />
    <Compile Include="UI\UiDebouncer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(MSBuildThisFileDirectory)..\..\lib\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MSBuildThisFileDirectory)..\..\lib\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(MSBuildThisFileDirectory)..\..\lib\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(MSBuildThisFileDirectory)..\..\lib\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="SDG.Glazier.Runtime" HintPath="$(MSBuildThisFileDirectory)..\..\lib\SDG.Glazier.Runtime.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(MSBuildThisFileDirectory)..\..\lib\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>
</Project>
